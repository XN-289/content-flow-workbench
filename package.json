{
  "name": "content-flow-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/server.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "collect": "node scripts/collect-all.mjs",
    "test:chain": "node scripts/chain-regression.mjs",
    "test:transcript:e2e": "node scripts/transcript-e2e-regression.mjs",
    "test:transcript:intake": "node scripts/transcript-intake-regression.mjs",
    "test:bilibili": "node scripts/bilibili-public-regression.mjs",
    "test:workflow:e2e": "node scripts/workflow-ux-regression.mjs",
    "test:backend": "node scripts/backend-pipeline-regression.mjs",
    "test:sources": "node scripts/source-intake-regression.mjs",
    "test:batch": "node scripts/batch-intake-regression.mjs",
    "test:media": "node scripts/platform-media-regression.mjs",
    "test:plugin": "node scripts/plugin-regression.mjs",
    "check:types": "node web/node_modules/typescript/bin/tsc --noEmit -p web/tsconfig.json",
    "sanitize:snapshots": "node scripts/sanitize-blocked-snapshots.mjs",
    "verify:workbench": "node scripts/verify-workbench.mjs",
    "verify": "node scripts/verify-workbench.mjs",
    "verify:source": "node scripts/verify-source-of-truth.mjs",
    "setup-task": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-startup-task.ps1 -StartNow",
    "remove-task": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-startup-task.ps1 -Uninstall"
  }
}
